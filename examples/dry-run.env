# Local run that never sends a text: replies are written to the log instead.
# sms-agent-bridge serve --env-file examples/dry-run.env
# python examples/simulate_twilio.py
DRY_RUN=true
TWILIO_AUTH_TOKEN=local-dev-token
PUBLIC_BASE_URL=https://sms.example.com
AGENT_BACKEND=echo
PORT=8080
STATUS_RECHECK_SECONDS=2
LOG_LEVEL=INFO
