# --- Twilio ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The number replies come from - or leave it empty and set a Messaging Service instead
TWILIO_FROM_NUMBER=+15550000000
TWILIO_MESSAGING_SERVICE_SID=
# The https:// address Twilio uses to reach this server (tunnel, reverse proxy or domain).
# Set the number's "A message comes in" webhook to  $PUBLIC_BASE_URL/twilio/sms  (HTTP POST)
PUBLIC_BASE_URL=https://sms.example.com

# --- agent -------------------------------------------------------------------
# echo | webhook | openai
AGENT_BACKEND=webhook
AGENT_WEBHOOK_URL=http://127.0.0.1:8090/agent
AGENT_WEBHOOK_TOKEN=change-me-to-a-long-random-string
# Any OpenAI-compatible /chat/completions endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
SYSTEM_PROMPT=
HISTORY_TURNS=12
AGENT_TIMEOUT_SECONDS=120
# A timed-out webhook call stays open, holding the sender's next text, until the agent
# answers or this many seconds after the call started
AGENT_TURN_LIMIT_SECONDS=600

# --- throughput and admission -------------------------------------------------
WORKERS=8
MAX_QUEUED_PER_SENDER=10
MAX_QUEUED_TOTAL=1000
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated numbers; empty = anyone may text the agent
ALLOWED_SENDERS=

# --- outbound text ------------------------------------------------------------
# lookalikes | strict | off
GSM_MODE=lookalikes
MAX_REPLY_PARTS=3
FAILURE_REPLY=
TIMEOUT_REPLY=
BUSY_REPLY=

# --- delivery verification ----------------------------------------------------
STATUS_RECHECK_SECONDS=30
RESEND_ON_FAILURE=true
RESEND_SUFFIX=

# --- server -------------------------------------------------------------------
DRY_RUN=false
VALIDATE_TWILIO_SIGNATURE=true
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
